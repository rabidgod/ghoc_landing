<style>
/* Layout: one dark column. Mark surfaces first, then the claim, then what it does, then the three rules, then how to reach him. Committed single dark theme — the subject is bioluminescence; neon needs real darkness. */
:root{
  --abyss:#101B2D;
  --deep:#16233C;
  --edge:#243654;
  --ink:#E9EFFA;
  --ink-soft:#96A8C6;
  --teal:#6FD8F2;
  --pink:#F2567A;
  --display:"Syne",system-ui,sans-serif;
  --body:"Figtree",system-ui,-apple-system,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{
  background:var(--abyss);
  color:var(--ink);
  font-family:var(--body);
  line-height:1.6;
  margin:0;
  padding-left:20px;padding-right:20px;
  padding-block:0 72px;
  overflow-x:hidden;
}
.shell{max-width:720px;margin:0 auto}

/* ---------- hero ---------- */
.hero{
  min-height:min(82vh,640px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;gap:26px;
  padding-block:72px 56px;
  position:relative;
}
.hero::after{
  content:"";position:absolute;inset:-20% -40% 20% -40%;z-index:-1;
  background:radial-gradient(closest-side,rgba(127,232,221,.13),transparent 72%);
  pointer-events:none;
}
.lockup{
  width:min(400px,82vw);height:auto;display:block;
  animation:rise 1.1s cubic-bezier(.2,.7,.3,1) both, breathe 5s 1.1s ease-in-out infinite;
}
.claim{
  font-family:var(--display);font-weight:600;
  font-size:clamp(1.45rem,6vw,2.1rem);
  line-height:1.2;margin:4px 0 0;
  text-wrap:balance;
  animation:rise .9s .3s cubic-bezier(.2,.7,.3,1) both;
}
.stance{
  font-size:clamp(.72rem,2.9vw,.84rem);
  letter-spacing:.2em;text-transform:uppercase;
  color:var(--teal);margin:14px 0 0;
  animation:rise .9s .44s cubic-bezier(.2,.7,.3,1) both;
}
.stance b{font-weight:600;color:#D8F6FF}

@keyframes rise{from{opacity:0;transform:translateY(16px) scale(.985)}to{opacity:1;transform:none}}
@keyframes breathe{0%,100%{filter:brightness(1)}50%{filter:brightness(1.1)}}
@media (prefers-reduced-motion:reduce){
  .lockup,.byline,.claim{animation:none}
}

/* ---------- sections ---------- */
section{padding-block:48px}
h2{
  font-family:var(--display);font-weight:600;
  font-size:.82rem;letter-spacing:.22em;text-transform:uppercase;
  color:var(--teal);margin:0 0 22px;
}
.lede{font-size:1.12rem;margin:0;max-width:60ch}
.lede + .lede{margin-top:20px}
.lede.turn{
  font-family:var(--display);font-weight:600;
  font-size:clamp(1.3rem,5vw,1.75rem);
  line-height:1.25;color:var(--teal);
  margin-top:28px;margin-bottom:28px;
}

.does{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(248px,1fr))}
.thing{
  background:var(--deep);border:1px solid var(--edge);
  border-radius:16px;padding:22px 20px;min-width:0;
}
.thing h3{
  font-family:var(--display);font-weight:600;font-size:1.02rem;
  margin:0 0 7px;color:var(--ink);
}
.thing p{margin:0;color:var(--ink-soft);font-size:.95rem}

.rules{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.rules li{
  display:flex;gap:16px;align-items:baseline;
  padding:18px 0;border-bottom:1px solid var(--edge);
}
.rules li:last-child{border-bottom:0}
.rules b{
  font-family:var(--display);font-weight:800;font-size:.95rem;
  color:var(--pink);flex:none;min-width:1.4em;
}
.rules span{min-width:0}
.rules strong{display:block;font-weight:600;color:var(--ink);margin-bottom:2px}
.rules small{color:var(--ink-soft);font-size:.93rem;line-height:1.55}

.contact{
  background:var(--deep);border:1px solid var(--edge);border-radius:18px;
  padding:26px 22px;display:flex;flex-direction:column;gap:14px;
}
.addr{
  font-family:var(--display);font-weight:600;
  font-size:clamp(1.05rem,4.6vw,1.35rem);
  color:var(--teal);word-break:break-word;margin:0;
}
button{
  font:inherit;font-weight:600;font-size:.9rem;
  background:transparent;color:var(--ink);
  border:1px solid var(--edge);border-radius:999px;
  padding:9px 18px;cursor:pointer;align-self:flex-start;
}
button:hover{border-color:var(--teal);color:var(--teal)}
button:focus-visible{outline:2px solid var(--teal);outline-offset:3px}

.a{color:var(--pink);font-size:1.05em;line-height:1}
footer{
  padding-top:40px;border-top:1px solid var(--edge);
  color:var(--ink-soft);font-size:.86rem;
  display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:space-between;
}
</style>

</head>
